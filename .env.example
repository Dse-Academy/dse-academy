GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_RPM=8

# Trilhas de estudo (python -m trilhas.gerar). Groq hospeda modelos abertos; sem chave, as trilhas saem por regras.
# Crie a chave em https://console.groq.com/keys. Modelos e limites mudam: https://console.groq.com/docs/models
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Supabase (Project Settings > API), usado pela API (apps/api). A chave anon/publishable é pública por design.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# API FastAPI (apps/api). Origens do front autorizadas no CORS, separadas por vírgula.
# API_ORIGENS_PERMITIDAS=http://localhost:3000
# Só para projetos Supabase antigos (JWT HS256). Projetos novos usam JWKS e não precisam disto.
# SUPABASE_JWT_SECRET=

# SÓ DESENVOLVIMENTO: abre o site como uma pessoa logada de teste (sem Supabase). Ignorada em produção. Nunca publique com isto.
# NEXT_PUBLIC_CONTA_FAKE=1
